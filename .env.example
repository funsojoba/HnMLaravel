APP_NAME="Hearts and Mind"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Toronto
APP_URL=https://heartsandmind.org

LOG_CHANNEL=stack
LOG_LEVEL=error

# --- Database (cPanel MySQL) ---
# Create the database + user in cPanel > MySQL Databases, then fill these in.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_cpanel_db_name
DB_USERNAME=your_cpanel_db_user
DB_PASSWORD=your_cpanel_db_password

# For local development you can instead use:
# DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# --- Stripe ---
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_KEY=pk_test_xxxxxxxxxxxxxxxx
STRIPE_SECRET=sk_test_xxxxxxxxxxxxxxxx
# Create a webhook endpoint (https://yourdomain.com/stripe/webhook) in
# https://dashboard.stripe.com/webhooks and paste its signing secret here.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# --- Admin account (seeded by `php artisan db:seed`) ---
ADMIN_NAME="Hearts and Mind Admin"
ADMIN_EMAIL=info@heartsandmind.org
ADMIN_PASSWORD=change-me-now

# --- Mail (optional: cPanel email account for form notifications) ---
MAIL_MAILER=log
MAIL_HOST=mail.heartsandmind.org
MAIL_PORT=465
MAIL_USERNAME=info@heartsandmind.org
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=info@heartsandmind.org
MAIL_FROM_NAME="${APP_NAME}"
